variable "project_name"{} variable "environment"{} resource "aws_vpc" "this" { cidr_block="10.20.0.0/16" tags={Name="${var.project_name}-${var.environment}-vpc"} } resource "aws_subnet" "public" { vpc_id=aws_vpc.this.id cidr_block="10.20.1.0/24" map_public_ip_on_launch=true availability_zone="ap-south-1a" } resource "aws_subnet" "private" { vpc_id=aws_vpc.this.id cidr_block="10.20.11.0/24" availability_zone="ap-south-1a" } output "vpc_id"{value=aws_vpc.this.id} output "public_subnet_id"{value=aws_subnet.public.id} output "private_subnet_ids"{value=[aws_subnet.private.id]}